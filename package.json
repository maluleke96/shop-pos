{
  "name": "shop-pos",
  "version": "2.10.34",
  "description": "Shop POS — Railway app + Supabase database (Web, Electron, Android)",
  "main": "electron/main.js",
  "author": "Happy",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "start:web": "node server.js",
    "start:electron": "electron .",
    "dev": "electron . --dev",
    "dev:web": "node server.js",
    "build": "node scripts/railway-build.js",
    "build:electron": "electron-builder --win --x64 --arm64",
    "build:portable": "electron-builder --win portable --x64 && node scripts/copy-windows-installer.js",
    "build:tablet": "electron-builder --win portable --arm64 && node scripts/copy-windows-installer.js",
    "build:release": "npm run build:electron && node scripts/create-release-zip.js && node scripts/create-source-zip.js",
    "build:mobile-www": "node scripts/build-mobile-www.js",
    "build:android": "node scripts/prepare-main-android.js && npm run build:mobile-www && npx cap sync android && node scripts/run-gradle-android.js && node scripts/copy-android-apk.js",
    "copy:windows-installers": "node scripts/copy-windows-installer.js",
    "build:cloud-windows": "node scripts/build-cloud-windows-apps.js",
    "build:cloud-android": "node scripts/build-cloud-android-apps.js",
    "build:cloud-shell-android": "node scripts/build-cloud-shell-android.js",
    "build:hr-accounting-android": "node scripts/build-hr-accounting-android.js",
    "build:manager-android": "node scripts/build-manager-android.js",
    "build:manager-windows": "node scripts/rebuild-manager-only.js",
    "build:order-windows": "node scripts/rebuild-order-only.js",
    "build:admin-windows": "node scripts/rebuild-admin-only.js",
    "build:referral-windows": "node scripts/rebuild-referral-windows.js",
    "deploy:referral": "node scripts/deploy-referral-apps.js",
    "build:order-android": "node scripts/build-order-android.js",
    "build:expense-android": "node scripts/build-portal-android.js expense",
    "build:studio-android": "node scripts/build-portal-android.js studio",
    "build:studio-windows": "node scripts/rebuild-studio-only.js",
    "build:driver-android": "node scripts/build-portal-android.js driver",
    "build:all-android": "node scripts/build-all-android-installers.js",
    "publish:android-downloads": "node scripts/publish-android-downloads.js",
    "build:hr-windows": "node scripts/rebuild-hr-only.js",
    "build:accounting-windows": "node scripts/rebuild-accounting-only.js",
    "prepare:cloud-android": "node scripts/write-capacitor-cloud-apps.js",
    "postinstall": "echo Skipping native rebuild",
    "supabase:inventory": "node scripts/inventory-sqlite.js",
    "supabase:schema": "node scripts/generate-supabase-schema.js",
    "supabase:export": "node scripts/export-sqlite-for-supabase.js",
    "supabase:import": "node scripts/import-to-supabase.js",
    "supabase:import:pg": "node scripts/import-to-supabase-pg.js",
    "supabase:reset-sequences": "node scripts/reset-pg-sequences.js",
    "netlify:env": "node scripts/netlify-build-env.js",
    "rpc:dev": "node scripts/rpc-dev-server.js",
    "supabase:verify": "node scripts/verify-supabase-counts.js",
    "supabase:link-auth": "node scripts/link-auth-users.js",
    "package:source": "node scripts/package-source.js",
    "package:railway": "node scripts/package-railway-source.js",
    "package:netlify-manual": "node scripts/package-netlify-manual.js",
    "smoke:rpc": "node scripts/smoke-rpc.js",
    "audit:admin": "node scripts/live-admin-audit.js",
    "audit:admin-performance": "node scripts/live-admin-performance-audit.js",
    "audit:operations": "node scripts/live-operations-audit.js",
    "audit:pos": "node scripts/live-multi-pos-validation.js",
    "audit:online-orders": "node scripts/live-combo-e2e.js",
    "audit:drivers": "node scripts/live-delivery-e2e.js",
    "audit:staff": "node scripts/live-staff-hr-e2e.js",
    "audit:recipes": "node scripts/live-combo-e2e.js",
    "audit:production": "node scripts/live-operations-audit.js --module=production",
    "audit:business-manager": "node scripts/live-operations-audit.js --module=business-manager",
    "audit:expenses": "node scripts/live-operations-audit.js --module=expenses",
    "test:signage": "node scripts/signage-test-suite.js",
    "test:kiosk-drivethru": "node scripts/kiosk-drive-thru-test-suite.js"
  },
  "dependencies": {
    "@capacitor/camera": "^6.1.3",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/share": "^6.0.4",
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^2.4.3",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "pg": "^8.23.0",
    "sql.js": "^1.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2"
  }
}
