{
  "appId": "com.shoppos.offline",
  "productName": "Shop POS",
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron/**/*",
    "src/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "portable",
        "arch": ["x64", "arm64"]
      }
    ]
  },
  "nsis": {
    "oneClick": true,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "artifactName": "Shop POS Setup ${arch}.${ext}"
  },
  "portable": {
    "artifactName": "ShopPOS-Portable-${arch}.${ext}"
  }
}
