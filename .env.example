# =============================================================================
# Shop POS — Railway + Supabase env template
# Copy to .env for local development. On Railway, set these in the dashboard.
# NEVER commit a real .env file. NEVER put DB passwords in the frontend.
# =============================================================================

# --- Public API (safe for browser / src/js/env.js) ---
SHOP_POS_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SHOP_POS_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Database (server-only — Railway Variables) ---
# (A) Discrete parts from Supabase → Project Settings → Database
SHOP_POS_DB_HOST=db.YOUR_PROJECT_REF.supabase.co
SHOP_POS_DB_PORT=5432
SHOP_POS_DB_NAME=postgres
SHOP_POS_DB_USER=postgres
SHOP_POS_DB_PASSWORD=your-database-password

# (B) Or full URI (overrides A). Must start with postgresql://
# On many Windows PCs, direct db.*.supabase.co is IPv6-only and fails.
# Prefer Session pooler (IPv4) from Supabase → Settings → Database → Connection string:
# SHOP_POS_DATABASE_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DATABASE_URL=

# Same-origin /rpc on Railway — leave empty in production
SHOP_POS_RPC_URL=
RPC_URL=

# Optional: local web port (Railway sets PORT automatically)
# PORT=3000

# Optional import-only (not required for Railway runtime):
# SUPABASE_SERVICE_ROLE_KEY=  (Dashboard → Settings → API → service_role)
