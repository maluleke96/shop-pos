{
  "appId": "com.shoppos.admin",
  "productName": "Shop POS Admin",
  "directories": {
    "output": "dist\\cloud-apps\\admin",
    "buildResources": "build"
  },
  "files": [
    "electron/admin-shell.js",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/admin-shell.js",
    "name": "com.shoppos.admin"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "artifactName": "ShopPOS-Admin-Setup.${ext}",
    "shortcutName": "Shop POS Admin"
  },
  "portable": {
    "artifactName": "ShopPOS-Admin-Portable.${ext}"
  }
}